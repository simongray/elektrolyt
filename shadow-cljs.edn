{;; read only by npx shadow-cljs; clojure -M:cljs:local takes the aliases
 ;; from the command line
 :deps     {:aliases [:cljs :local]}
 :dev-http {;; the workbench of the views, at http://localhost:8402, with
            ;; the app's stylesheet and Portfolio's own files
            8402 ["dev-resources/public" "public" "classpath:public"]}
 :builds   {;; the page at /js/shared.js and /js/main.js, and its web worker
            ;; at /js/worker.js, which share the code of the library
            :app       {:target     :browser
                        :output-dir "public/js"
                        :asset-path "/js"
                        :modules    {:shared {:entries []}
                                     :main   {:init-fn    dk.simongray.elektrolyt/init
                                              :depends-on #{:shared}}
                                     :worker {:init-fn    dk.simongray.elektrolyt.worker/init
                                              :depends-on #{:shared}
                                              :web-worker true}}
                        ;; a release goes beside the watch's files, never
                        ;; over them
                        :release    {:output-dir "target/release/js"}}
            ;; a scene for each state of each view, from the namespaces of
            ;; dev/ that end in -scenes
            :portfolio {:target     :portfolio
                        :runner-ns  dk.simongray.elektrolyt.portfolio
                        :output-dir "dev-resources/public/js"
                        :asset-path "/js"
                        :html-file  {:path  "dev-resources/public/index.html"
                                     :title "Elektrolyt views"}}
            ;; clojure -M:cljs:local compile test  (the tests in Node)
            :test      {:target    :node-test
                        :output-to "target/node-tests.js"
                        :ns-regexp "-test$"
                        :autorun   true}}}
