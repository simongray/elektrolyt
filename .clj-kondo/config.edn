{:linters       {:missing-docstring {:level :warning}
                 :unused-binding    {:exclude-destructured-as true}}
 ;; a scene is a var of its own, and an alias a function
 :lint-as       {portfolio.replicant/defscene clojure.core/def
                 replicant.alias/defalias     clojure.core/defn}
 ;; test fixtures need no docstrings, nor the icons, which Phosphor names
 :ns-groups     [{:pattern "dk\\.simongray\\.elektrolyt\\..*-test" :name tests}]
 :config-in-ns  {tests                           {:linters {:missing-docstring {:level :off}}}
                 dk.simongray.elektrolyt.ui.icons {:linters {:missing-docstring {:level :off}}}}}
