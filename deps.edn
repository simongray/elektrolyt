{:paths ["src"]

 ;; podcast-clj for the feeds and the listener's library, play-nice for the
 ;; playing, colour-coded for the colours of the artwork, Replicant for the
 ;; rendering, Nexus for the actions that the views dispatch, reitit for the
 ;; routes, and Telemere for the logs of the page, its worker and the server.
 ;;
 ;; Replicant comes from the commit of its PR #83 too, which fixes issue #81:
 ;; a keyed child that moves to the front and changes keeps its old vdom, so
 ;; that a later render removes the wrong node, as the search results that
 ;; arrive in stages do. Switch back to the release on Clojars once #83 is
 ;; merged and released.
 ;; https://github.com/cjohansen/replicant/pull/83
 :deps  {dk.simongray/podcast-clj {:mvn/version "0.5.2"}
         dk.simongray/play-nice   {:mvn/version "0.7.0"}
         dk.simongray/colour-coded {:mvn/version "0.1.0"}
         no.cjohansen/replicant   {:git/url "https://github.com/pyze/replicant.git"
                                   :git/sha "ec3cdd264a6660926cf11bc55c25cac7008b8fd1"}
         no.cjohansen/nexus       {:mvn/version "2026.08.1"}
         metosin/reitit-frontend  {:mvn/version "0.11.0"}
         com.taoensso/telemere    {:mvn/version "1.4.0"}
         ;; the caches of searches and shows and the id of the browser, and
         ;; the cache mode of their requests, which the app requires itself
         dk.simongray/like-minded {:mvn/version "0.9.2"}
         dk.simongray/wary-fetch  {:mvn/version "0.16.1"}
         ;; what the app's server tells the page, as transit
         com.cognitect/transit-cljs {:mvn/version "0.8.280"}}

 :aliases
 {;; clojure -M:cljs:local watch app portfolio  (see shadow-cljs.edn)
  :cljs  {:extra-paths ["dev" "test"]
          :extra-deps  {org.clojure/clojure    {:mvn/version "1.12.6"}
                        thheller/shadow-cljs   {:mvn/version "3.5.7"}
                        no.cjohansen/portfolio {:mvn/version "2026.03.1"}}
          :main-opts   ["-m" "shadow.cljs.devtools.cli"]}

  ;; The app's own server, for its files and the proxy, on the same Pedestal
  ;; as podcast-clj's server. What Pedestal logs through SLF4J reaches
  ;; Telemere through telemere-slf4j, and the server tells the page what it
  ;; offers as transit. Its namespaces are in src with the rest of the app,
  ;; and this alias adds the libraries that they need on the JVM.
  :server {:extra-deps {org.clojure/clojure          {:mvn/version "1.12.6"}
                        io.pedestal/pedestal.service {:mvn/version "0.8.2"}
                        io.pedestal/pedestal.jetty   {:mvn/version "0.8.2"}
                        com.taoensso/telemere-slf4j  {:mvn/version "1.4.0"}
                        com.cognitect/transit-clj    {:mvn/version "1.1.363"}}}

  ;; the server and the watch in one JVM, with an nREPL server (see
  ;; dev/user.clj): clojure -M:cljs:server:local:serve
  :serve {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}}
          :main-opts  ["-e" "(start!)" "-m" "nrepl.cmdline"]}

  ;; the server's tests on the JVM, and the checks of the namespaces that
  ;; reach outside the store, that read the player's clock, of the icons
  ;; and of the worker's namespaces: clojure -X:server:local:test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:patterns ["dk\\.simongray\\.elektrolyt\\.server.*"
                                  "dk\\.simongray\\.elektrolyt\\.runtime-test"
                                  "dk\\.simongray\\.elektrolyt\\.clock-test"
                                  "dk\\.simongray\\.elektrolyt\\.icons-test"
                                  "dk\\.simongray\\.elektrolyt\\.worker-test"]}}

  ;; podcast-clj, play-nice and colour-coded from the checkouts beside this
  ;; one, and like-minded, mind-meld, wary-fetch and drop-in-search below
  ;; podcast-clj, so that a fix in any of them shows in the app at once
  :local {:override-deps
          {dk.simongray/podcast-clj     {:local/root "../podcast-clj"}
           dk.simongray/play-nice       {:local/root "../play-nice"}
           dk.simongray/colour-coded    {:local/root "../colour-coded"}
           dk.simongray/like-minded     {:local/root "../like-minded"}
           dk.simongray/mind-meld       {:local/root "../mind-meld"}
           dk.simongray/wary-fetch      {:local/root "../wary-fetch"}
           dk.simongray/drop-in-search  {:local/root "../drop-in-search"}}}}}
