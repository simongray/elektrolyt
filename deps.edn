{:paths ["src"]

 ;; podcast-clj for the feeds and the listener's library, play-nice for the
 ;; playing, Replicant for the rendering, Nexus for the actions that the
 ;; views dispatch, and reitit for the routes. Both of the podcast libraries
 ;; are ahead of their releases, so they come from Git.
 :deps  {dk.simongray/podcast-clj {:git/url "https://github.com/simongray/podcast-clj.git"
                                   :git/sha "381f7a8ae32338cbb81cdf0b6276c39401415848"}
         dk.simongray/play-nice   {:git/url "https://github.com/simongray/play-nice.git"
                                   :git/sha "3e14ba6cdd8850f8ec775939a85a6535adf90c57"}
         no.cjohansen/replicant   {:mvn/version "2026.07.1"}
         no.cjohansen/nexus       {:mvn/version "2026.08.1"}
         metosin/reitit-frontend  {:mvn/version "0.11.0"}}

 :aliases
 {;; clojure -M:cljs:local watch app portfolio  (see shadow-cljs.edn)
  :cljs  {:extra-paths ["dev" "test"]
          :extra-deps  {org.clojure/clojure    {:mvn/version "1.12.5"}
                        thheller/shadow-cljs   {:mvn/version "3.5.7"}
                        no.cjohansen/portfolio {:mvn/version "2026.03.1"}}
          :main-opts   ["-m" "shadow.cljs.devtools.cli"]}

  ;; The app's own server, for its files and the proxy, on the same Pedestal
  ;; as podcast-clj's server. It logs to stderr through slf4j-simple.
  :server {:extra-paths ["server"]
           :extra-deps  {org.clojure/clojure          {:mvn/version "1.12.5"}
                         io.pedestal/pedestal.service {:mvn/version "0.8.2-beta-11"}
                         io.pedestal/pedestal.jetty   {:mvn/version "0.8.2-beta-11"}
                         org.slf4j/slf4j-simple       {:mvn/version "2.0.18"}}}

  ;; the server and the watch in one JVM, with an nREPL server (see
  ;; dev/user.clj): clojure -M:cljs:server:local:serve
  :serve {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts  ["-e" "(start!)" "-m" "nrepl.cmdline"]}

  ;; the server's tests on the JVM: clojure -X:server:local:test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:patterns ["dk\\.simongray\\.podcast-app\\.server.*"]}}

  ;; podcast-clj and play-nice from the checkouts beside this one, so that
  ;; a fix in either shows in the app at once
  :local {:override-deps
          {dk.simongray/podcast-clj {:local/root "../podcasting"}
           dk.simongray/play-nice   {:local/root "../play-nice"}}}}}
